{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Django",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver"],
      "django": true,
      "justMyCode": false
    },
    {
      "name": "Python: Celery",
      "type": "python",
      "request": "launch",
      "module": "celery",
      "args": ["-A", "config", "worker", "--beat", "--scheduler", "django"]
    },
    {
      "name": "Python: Flower",
      "type": "python",
      "request": "launch",
      "module": "celery",
      "args": ["-A", "config", "flower"]
    }
  ]
}
